## 拾える字（部品）に添える一言。手に持ったとき、案内に出す。
const PART_NOTE := {
	"父": "父。力持ち。",
	"斤": "斤（おの）の刃。柄が無いと振れない。",
	"人": "旅の人。",
	"木": "苗木。",
	"金": "金。きらきらしている。",
	"失": "失。なにかを失くした形。",
	"火": "火。持ったまま弓を射ると、火矢になる。",
	"丁": "丁（くぎ）。",
	"日": "日。あたたかい。",
	"月": "月。つめたく光る。",
	"口": "口。",
	"鳥": "鳥。",
	"生": "生。芽生えの形。",
	"弓": "弓。長押しで引き絞り、離して射る。",
}

## a と b を合わせた字。合わなければ空の文字列。
## RECIPES のキーは書いたままの順で持っているので、両方の並びを試す。
static func combine(a: String, b: String) -> String:
	if RECIPES.has(a + b):
		return RECIPES[a + b]
	if RECIPES.has(b + a):
		return RECIPES[b + a]
	return ""

## できあがる字の、合わせ方（「父＋斤」）。
static func formula(result: String) -> String:
	for k in RECIPES:
		if RECIPES[k] == result:
			return "%s ＋ %s" % [k.substr(0, 1), k.substr(1, 1)]
	return ""
