class_name Kanji
## 字の決まりごと。どれとどれを合わせると何になるか、
## できた字がどんな字か、を一か所にまとめる。
##
## 合わせる順番は問わない（父＋斤 も 斤＋父 も 斧）。

## 合わせ方。キーは 2 つの字を並べたもの（並びは _key() が揃える）。
const RECIPES := {
	"父斤": "斧",
	"金失": "鉄",
	"火丁": "灯",
	"木木": "林",
	"林木": "森",
	"日月": "明",
	"人木": "休",
	"火火": "炎",
	"口鳥": "鳴",
	"日生": "星",
}

## 字典に載せる順番。遊んでいく順に並べる。
const DEX_ORDER := ["斧", "休", "鉄", "炎", "灯", "林", "森", "鳴", "明", "星"]

## できた字の説明。字典と、合わせた瞬間の札に出す。
const INFO := {
